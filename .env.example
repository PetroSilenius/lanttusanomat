# Canonical site origin used for metadata, sitemap, RSS and canonical URLs.
# Set this in the Cloudflare Pages build environment for production/custom domains.
NEXT_PUBLIC_SITE_URL=https://lanttusanomat.pages.dev

# Claude API key for the article generation pipeline (scripts/generate-articles.mts).
# In production this lives ONLY as a GitHub Actions secret — never commit it and
# never expose it to the frontend build.
# ANTHROPIC_API_KEY=sk-ant-...
