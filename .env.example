# Canonical site origin used for metadata, sitemap, RSS and canonical URLs.
# Set this in the Cloudflare Pages build environment for production/custom domains.
NEXT_PUBLIC_SITE_URL=https://lanttusanomat.pages.dev

# Article generation runs entirely in GitHub Actions and needs no local secret.
# The workflow authenticates with a CLAUDE_CODE_OAUTH_TOKEN repo secret (from
# `claude setup-token`) — never committed, never exposed to the frontend build.
# `pnpm select:topics` runs locally with no credential (it only reads RSS feeds).
