# Canonical site origin used for metadata, sitemap, RSS and canonical URLs.
# Set this in the Cloudflare Pages build environment for production/custom domains.
NEXT_PUBLIC_SITE_URL=https://lanttusanomat.pages.dev

# Claude credential for the article generation pipeline (scripts/generate-articles.mts).
# Use ONE of the two. In production these live ONLY as GitHub Actions secrets —
# never commit them and never expose them to the frontend build.
#
# Console API key (recommended; https://console.anthropic.com/settings/keys):
# ANTHROPIC_API_KEY=sk-ant-api...
#
# OAuth access token, sent as a Bearer token (an sk-ant-oat… value in
# ANTHROPIC_API_KEY is auto-detected and treated the same way):
# ANTHROPIC_AUTH_TOKEN=sk-ant-oat...
