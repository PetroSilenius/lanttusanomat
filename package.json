{
  "name": "lanttusanomat",
  "version": "0.1.0",
  "private": true,
  "description": "Lanttusanomat – suomalainen satiiriuutissivusto. Finnish satire news site built as a static Next.js PWA.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve-static.mjs out 3000",
    "serve": "node scripts/serve-static.mjs out 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lhci": "pnpm dlx @lhci/cli@0.15.x autorun",
    "select:topics": "tsx scripts/select-topics.mts",
    "validate:articles": "tsx scripts/validate-articles.mts",
    "validate:articles:dry": "tsx scripts/validate-articles.mts --dry-run",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^16.2.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "^3.3.18"
    }
  }
}
